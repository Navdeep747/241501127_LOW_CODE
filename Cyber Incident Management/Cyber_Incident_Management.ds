/*
 * Author       : navdeep.n.2024.aiml_rajal723
 * Generated on : 01-Nov-2026 09:49:04
 * Version      : 1.0
 */
 application "Cyber Incident Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form incident_report_log
		{
			displayname = "Incident Report Log"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			incident_id
			(
    			type = autonumber
				displayname = "Incident Id"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			incident_title
			(
    			type = text
				displayname = "Incident Title"
	 			row = 1
	 			column = 1   
				width = medium
			)
			incident_type
			(
				type = picklist
				displayname = "Incident Type"
				values = {"Unauthorized Access","Data Breach","Phishing","Malware","Suspicious Activity","Ransomware","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			description
			(
    			type = textarea
				displayname = "Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			reporter_name
			(
    			type = text
				displayname = "Reporter Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			contact_email
			(
    			type = email
				displayname = "Contact Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			contact_number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			submitted_date_time
			(
    			type = datetime
				displayname = "Submitted Date And Time"
				initial value = "${zoho.currenttime}"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			severity_level
			(
				type = picklist
				displayname = "Severity Level"
				values = {"High","Low","Medium","Critical"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			affected_systems
			(
    			type = textarea
				displayname = "Affected Systems"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Evidence_Attachment
			(
    			type = image
				displayname = "Evidence Attachment"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Keyword
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = KeywordExtractor
									basefield = description
						)
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Incident Received","Incident Triage","Incident Assigned","Incident Pending Information","Incident False Positive","Incident Escalated","Incident Investigation","Incident Reassigned","Incident Mitigation","Incident Resolved","Incident Closed","Incident Reopened"}
			}
		}
		form report_status_log
		{
			displayname = "Report Status Log"
			success message = "Report Status Log Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			incident_id
			(
				type = picklist	
				displayname = "Incident Id"
				values  = incident_report_log.ID
    			displayformat = [incident_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			current_status
			(
				type = picklist
				displayname = "Current Status"
				values = {"Submitted","Closed","Under Investigation","Resolved"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			assigned_investigator
			(
    			type = text
				displayname = "Assigned Investigator"
	 			row = 1
	 			column = 1   
				width = medium
			)
			investigation_notes
			(
    			type = textarea
				displayname = "Investigation Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			action_taken
			(
    			type = textarea
				displayname = "Action Taken"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			resolution_summary
			(
    			type = textarea
				displayname = "Resolution Summary"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_updated
			(
    			type = datetime
				displayname = "Last Updated"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			resolution_date
			(
    			type = date
				displayname = "Resolution Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Incident Reported","Investigation Assigned","Incident Closed","Investigation In Progress","Pending Management Review","Resolution Drafted","Action Plan Approved"}
			}
		}
	}
	reports
	{
		list report_status_log_Report
		{
			displayName = "All Report Status Logs"
			show all rows from report_status_log    
			(
				incident_id as "Incident Id"
				current_status as "Current Status"
				assigned_investigator as "Assigned Investigator"
				investigation_notes as "Investigation Notes"
				action_taken as "Action Taken"
				resolution_summary as "Resolution Summary"
				last_updated as "Last Updated"
				resolution_date as "Resolution Date"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (current_status == "Closed")
				fields = [current_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (current_status == "Resolved")
				fields = [current_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (current_status == "Submitted")
				fields = [current_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban report_status_log_by_current_status
		{
			displayName = "Current Statuses"
			show all rows from report_status_log    
			(
				incident_id as "Incident Id"
				current_status as "Current Status"
				assigned_investigator as "Assigned Investigator"
				investigation_notes as "Investigation Notes"
				action_taken as "Action Taken"
				resolution_summary as "Resolution Summary"
				last_updated as "Last Updated"
				resolution_date as "Resolution Date"
			)
			options
			(
	 			display field = current_status
	 		)
		}
		list incident_report_log_Report
		{
			displayName = "Incident Report Log Report"
			show all rows from incident_report_log    
			(
				incident_id as "Incident Id"
				incident_title as "Incident Title"
				incident_type as "Incident Type"
				description as "Description"
				reporter_name as "Reporter Name"
				contact_email as "Contact Email"
				contact_number as "Contact Number"
				submitted_date_time as "Submitted Date And Time"
				severity_level as "Severity Level"
				affected_systems as "Affected Systems"
				Keyword
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (severity_level == "Critical")
				fields = [severity_level]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (severity_level == "High")
				fields = [severity_level]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (severity_level == "Low")
				fields = [severity_level]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban incident_report_log_by_incident_type
		{
			displayName = "Incident Types"
			show all rows from incident_report_log    
			(
				incident_id as "Incident Id"
				incident_title as "Incident Title"
				incident_type as "Incident Type"
				description as "Description"
				reporter_name as "Reporter Name"
				contact_email as "Contact Email"
				contact_number as "Contact Number"
				submitted_date_time as "Submitted Date And Time"
				severity_level as "Severity Level"
				affected_systems as "Affected Systems"
			)
			options
			(
	 			display field = incident_type
	 		)
		}
	}
	pages
	{
		page DashBoard
		{
			displayname = "Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<row>\n\t<column\n   \t\t width='25%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\t\twidth = '50%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\t\thAlign = 'left'\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#3F3F3F'\n\tsize = '24px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t\tcriteria = 'current_status == &quot;Submitted&quot;'\n\t  value = 'thisapp.report_status_log.current_status.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#909090'\n\tsize = '14px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\n\n\n\n\n\t  value = 'Count of Submitted'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc><pc \n\t\tpadding = '20px'\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\t\twidth = '50%'\n\t\thAlign = 'right'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '10px'\n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\n\tcolor = '#FFFFFF'\n\tbgColor = 'theme'\n\twidth = '40px'\n\theight = '40px'\n\ttype = 'icon'\n\tvalue = 'sport-cardio'\n\tsize = '22px'\n\tcornerRadius = '10px'\n\ticonType = 'outline'\n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='23%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\t\twidth = '50%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpaddingTop = '0px'\n\tpaddingLeft = '10px'\n\tpaddingRight = '0px'\n\tpaddingBottom = '0px'\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\t\thAlign = 'left'\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#3F3F3F'\n\tsize = '24px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t\tcriteria = 'current_status == &quot;Closed&quot;'\n\t  value = 'thisapp.report_status_log.current_status.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#909090'\n\tsize = '14px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\n\n\n\n\n\t  value = 'Count of Closed'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc><pc \n\t\tpadding = '20px'\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\t\twidth = '50%'\n\t\thAlign = 'right'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\n\tcolor = '#FFFFFF'\n\tbgColor = 'theme'\n\twidth = '40px'\n\theight = '40px'\n\ttype = 'icon'\n\tvalue = 'business-progress'\n\tsize = '22px'\n\tcornerRadius = '10px'\n\ticonType = 'outline'\n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='27%'\n  