		workflow
		{
		form
		{
			auto_assign_critical_severity as "Auto-assign Critical Severity"
			{
				type =  form
				form = incident_report_log

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the current logged-in user's email
										loggedInUserEmail = zoho.loginuserid;
										// Check if the incident severity is Critical
										if(input.severity_level == "Critical")
										{
											// Assign the logged-in user as the senior investigator
											assigned_investigator = loggedInUserEmail;
										}
						)
					}
				}

			}
			notify_investigator_on_update as "Notify Investigator on Update"
			{
				type =  form
				form = report_status_log

				record event = on edit

				on user input of current_status
				{
					actions 
					{
						custom deluge script
						(
											// Get the current status value from input
										newStatus = input.current_status;
										// Check if the status has changed to a specific value that requires notification
										if(newStatus == "Under Investigation" || newStatus == "Resolved" || newStatus == "Closed")
										{
											// Fetch the assigned investigator from the current record
											assignedInvestigator = input.assigned_investigator;
											// Get the incident ID to include in the notification
											incidentId = input.incident_id;
											// Fetch the incident record to get reporter email
											incidentRecord = incident_report_log[ID == incidentId];
											// Get the reporter's email from the incident record
											reporterEmail = incidentRecord.contact_email;
											// Send notification to the assigned investigator
											// Using zoho.loginuserid as the sender
											sendmail
											[
												from :zoho.loginuserid
												to :assignedInvestigator
												subject :"Incident Status Update - " + incidentId.toString()
												message :"<p>Dear Investigator,</p><p>The incident with ID " + incidentId.toString() + " has been updated to status: " + newStatus + ".</p><p>Please review the incident details and take necessary action.</p>"
											]
											// Send push notification to the assigned investigator
											pushNotification = zoho.pushNotification(assignedInvestigator,"Incident Status Update","Incident " + incidentId.toString() + " status changed to " + newStatus,"report_status_log",input.ID);
										}
						)
					}
				}

			}
			Email_trigger as "Email trigger"
			{
				type =  form
				form = incident_report_log

				record event = on add

				on success
				{
					actions 
					{
						sendmail
						(
							from : "navdeep.n.2024.aiml@rajalakshmi.edu.in"
							to : contact_email
							subject : "Cyber Incident Report Received - ${incident_id}"
							message : "<p><span>Dear ${reporter_name},</span><br></p><p><span>Your cyber incident report has been successfully submitted to the IT department.</span><br></p><p><b><span>Incident Details:</span></b><br></p><ul><li><p style=\"margin-top: 0px;\"><span>Incident ID:&nbsp;${incident_id}</span><br></p></li><li><p style=\"margin-top: 0px;\"><span>Incident Title:&nbsp;${incident_title}</span><br></p></li><li><p style=\"margin-top: 0px;\"><span>Incident Type:&nbsp;${incident_type}</span><br></p></li><li><p style=\"margin-top: 0px;\"><span>Submission Date:&nbsp;${submitted_date_time}</span><br></p></li></ul><p><span>Our IT team will review your report and take the necessary action.</span><br></p><p><span>Please keep your Incident ID for future reference.</span><br></p><p><br></p><div><span>Regards,</span><br></div><div><span>College IT Department</span><br></div><p><br></p><div><br></div>"
						)
					}
				}

			}
			Notify_Reporter_on_Status as "Notify Reporter on Status Update"
			{
				type =  form
				form = report_status_log

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Retrieve the related incident record
										incidentRecord = incident_report_log[ID == input.incident_id];
										if(incidentRecord != null)
										{
											reporterEmail = incidentRecord.contact_email;
											if(reporterEmail != null && reporterEmail != "")
											{
												sendmail
												[
													from :zoho.loginuserid
													to :reporterEmail
													subject :"Cyber Incident - Status Update"
													message :"Your incident report status has been updated to: " + input.current_status + ". Please check your incident report for the latest information."
												]
											}
										}
						)
					}
				}

			}
		}




